<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="178dp" app:cardCornerRadius="15dp" app:cardBackgroundColor="@color/moss"
    app:strokeWidth="0dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/recipe_image" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <LinearLayout android:id="@+id/recipe_content" android:layout_width="match_parent"
            android:layout_height="82dp" android:layout_gravity="bottom" android:gravity="bottom"
            android:orientation="vertical" android:background="@drawable/bg_photo_scrim"
            android:paddingStart="12dp" android:paddingEnd="56dp" android:paddingBottom="12dp">
            <TextView android:id="@+id/recipe_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"
                android:textColor="@android:color/white" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/recipe_meta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@android:color/white"
                android:paddingTop="4dp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/recipe_favorite" android:layout_width="44dp"
            android:layout_height="44dp" android:layout_gravity="bottom|end"
            android:layout_margin="7dp" android:background="@drawable/bg_heart_circle"
            android:padding="10dp" android:src="@drawable/ic_heart"/>
        <ImageButton android:id="@+id/recipe_edit" android:layout_width="44dp"
            android:layout_height="44dp" android:visibility="gone"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
